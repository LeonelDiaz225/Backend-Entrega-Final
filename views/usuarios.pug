extends layout

block content
  h1.page-title= title
  p.subtitle Cuentas registradas en AgroTec.
  section.panel
    if usuarios.length > 0
      .table-wrap
        table.data-table
          thead
            tr
              th Usuario
              th Nombre
              th Apellido
              th Email
          tbody
            each usuario in usuarios
              tr
                td= usuario.username
                td= usuario.nombre
                td= usuario.apellido
                td= usuario.email
    else
      p.empty-state No hay usuarios registrados.
