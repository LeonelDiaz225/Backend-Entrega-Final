extends layout

block content
  h1.page-title= title
  p.subtitle Administración de cuentas de AgroTec.

  section.panel
    h2 Usuarios registrados

    if usuarios.length > 0
      .table-wrap
        table.data-table
          thead
            tr
              th Usuario
              th Nombre
              th Apellido
              th Email
              th Rol
              th Acciones
          tbody
            each usuario in usuarios
              tr
                td= usuario.username
                td= usuario.nombre
                td= usuario.apellido
                td= usuario.email
                td= usuario.role
                td
                  a.btn.btn-primary(
                    href="/vista/usuarios/" + usuario._id + "/editar"
                  ) Editar

                  if String(usuario._id) !== String(usuarioActualId)
                    form(
                      action="/vista/usuarios/" + usuario._id + "/eliminar"
                      method="POST"
                      style="display:inline-block; margin-left:8px;"
                      onsubmit="return confirm('¿Seguro que deseas eliminar esta cuenta?');"
                    )
                      button.btn(type="submit") Eliminar
    else
      p.empty-state No hay usuarios registrados.


