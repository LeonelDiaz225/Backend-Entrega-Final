extends layout

block content
  h1.page-title= title
  p.subtitle Catálogo de tipos de cultivo.
  section.panel
    if tiposCultivo.length > 0
      .table-wrap
        table.data-table
          thead
            tr
              th Número
              th Tipo de cultivo
          tbody
            each tipo, index in tiposCultivo
              tr
                td= index + 1
                td= tipo.nombre
    else
      p.empty-state No hay tipos de cultivo registrados.
