
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar sesión | AgroTec

    style.
      body {
        font-family: Arial, sans-serif;
        background: #f0f5f0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
      }

      .login-container {
        background: white;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 320px;
      }

      h1 {
        text-align: center;
        color: #2e7d32;
      }

      p {
        text-align: center;
        color: #666;
      }

      label {
        display: block;
        margin-top: 15px;
        font-weight: bold;
      }

      input {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
      }

      button {
        width: 100%;
        padding: 12px;
        margin-top: 25px;
        background: #2e7d32;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
      }

      button:hover {
        background: #1b5e20;
      }

  
body
  .login-container
    h1 AgroTec
    p Sistema de Monitoreo Agrícola

    if error
      p(style="color: #c62828; font-weight: bold;")= error

    form(id="loginForm" method="POST" action="/login")
      label(for="username") Usuario
      input(type="text" id="username" name="username" required)

      label(for="password") Contraseña
      input(type="password" id="password" name="password" required)

      button(type="submit") Iniciar sesión

