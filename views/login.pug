doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar sesión | AgroTec
    link(rel="stylesheet", href="/css/styles.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap")

  body.login-page
    main.login-card
      .login-brand
        img.login-logo(src="/icon/logo-blanco.png", alt="Logo AgroTec")
        h1 AgroTec
      p.subtitle Sistema de Monitoreo Agrícola
      if error
        p.form-error(role="alert")= error
      form(id="loginForm", method="POST", action="/login")
        .form-field
          label(for="username") Usuario
          input(type="text", id="username", name="username", required, autocomplete="username")
        .form-field
          label(for="password") Contraseña
          input(type="password", id="password", name="password", required, autocomplete="current-password")
        button.btn.btn-primary(type="submit") Iniciar sesión
