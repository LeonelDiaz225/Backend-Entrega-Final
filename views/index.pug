extends layout

block content
  section.panel
    h1.page-title Panel de administración
    p.subtitle= message || 'Bienvenido al Sistema de Monitoreo Agrícola AgroTec.'
    p Desde aquí puedes acceder a los módulos disponibles del sistema.
    span.status ● Sistema operativo

    if usuarioActual
      p
        strong Usuario:
        |  #{usuarioActual.username}

      p
        strong Rol:
        |  #{usuarioActual.role}


  h2.section-title Módulos del sistema
  section.cards
    a.card(href="/vista/lotes")
      .card-icon 🌾
      h3 Lotes
      p Consulta los lotes agrícolas y su historial de observaciones.
    
    if usuarioActual && ["admin", "tecnico"].includes(usuarioActual.role)
      a.card(href="/vista/productores")
        .card-icon 👨‍🌾
        h3 Productores
        p Consulta productores y establecimientos registrados.
      a.card(href="/vista/tecnicos")
        .card-icon 🛠️
        h3 Técnicos
        p Consulta los técnicos responsables del seguimiento.
      a.card(href="/vista/tipos-cultivo")
        .card-icon 🌱
        h3 Tipos de cultivo
        p Revisa el catálogo de cultivos registrados.
    
    if usuarioActual && usuarioActual.role === "admin"
      a.card(href="/vista/usuarios")
        h3 Usuarios
        p Consulta las cuentas registradas en AgroTec.

