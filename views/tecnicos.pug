extends layout

block content
  h1.page-title= title
  p.subtitle Técnicos que realizan el seguimiento de cultivos.
  section.panel
    if tecnicos.length > 0
      .table-wrap
        table.data-table
          thead
            tr
              th Técnico
              th Especialidad
              th Teléfono
              th Email
          tbody
            each tecnico in tecnicos
              tr
                td #{tecnico.nombre} #{tecnico.apellido}
                td= tecnico.especialidad || 'Sin especificar'
                td= tecnico.telefono || 'Sin teléfono'
                td= tecnico.email || 'Sin email'
    else
      p.empty-state No hay técnicos registrados.
